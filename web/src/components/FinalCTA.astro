---
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props { waUrl?: string }
const { waUrl } = Astro.props;
---

<section class="py-14 md:py-20" aria-labelledby="cta-title">
  <div class="container-x">
    <div data-reveal class="flex flex-col items-start justify-between gap-8 rounded-card bg-gradient-to-r from-accent via-accent-active to-ground p-8 shadow-glow-accent md:flex-row md:items-center md:p-12">
      <div class="max-w-xl">
        <h2 id="cta-title" class="font-display text-headline-lg-mobile md:text-headline-lg">Butuh Mobil? Cek Ketersediaan Unit Sekarang</h2>
        <p class="mt-3 text-body-md text-fg/85">Chat admin, sebutkan tanggal dan tujuan Anda. Kami bantu pilihkan unit dan paket yang sesuai.</p>
      </div>
      {waUrl && (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-track="true"
          data-wa-location="final_cta"
          class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-control bg-wa px-8 font-display text-title-md font-bold text-white shadow-glow-wa transition-colors hover:bg-wa-hover"
        >
          <WhatsAppIcon /> Chat Admin via WhatsApp
        </a>
      )}
    </div>
  </div>
</section>

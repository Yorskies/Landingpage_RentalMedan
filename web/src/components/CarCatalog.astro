---
import CarCard from './CarCard.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import type { Car } from '../lib/sanity';

interface Props { cars: Car[]; phone?: string; emptyWaUrl?: string }
const { cars, phone, emptyWaUrl } = Astro.props;

const ORDER = ['City Car', 'MPV Keluarga', 'SUV Premium', 'Minibus'];
// Only categories that actually have cars get a pill (avoids empty filter results)
const categories = ORDER.filter((c) => cars.some((car) => car.category === c));

const pill = 'min-h-11 rounded-chip bg-card px-4 text-label-md text-muted transition-colors hover:text-fg aria-pressed:bg-elevated aria-pressed:text-fg aria-pressed:ring-1 aria-pressed:ring-line';
---

<section id="armada" class="scroll-mt-20 py-14 md:py-20" aria-labelledby="armada-title">
  <div class="container-x">
    <header data-reveal class="mx-auto max-w-2xl text-center">
      <p class="text-label-sm uppercase text-accent-text">Daftar kendaraan</p>
      <h2 id="armada-title" class="mt-2 font-display text-headline-lg-mobile md:text-headline-lg">Pilih Armada &amp; Paket Sewa</h2>
      <p class="mt-3 text-body-md text-muted">Pilih paket Lepas Kunci atau Dengan Supir, lalu tanyakan langsung ketersediaan unit lewat WhatsApp.</p>
    </header>

    <div id="catalog" data-catalog class="mt-8">
      <div data-reveal class="flex justify-center">
        <div role="group" aria-label="Pilih paket sewa" data-pkg-group data-active="self" class="group relative grid w-full max-w-md grid-cols-2 gap-1 rounded-full border border-line bg-card p-1">
          <!-- Sliding indicator: moved by data-active on the group (width = one button: 50% minus half of padding+gap) -->
          <span aria-hidden="true" class="absolute inset-y-1 left-1 w-[calc(50%-0.375rem)] rounded-full bg-accent shadow-glow-accent transition-transform duration-300 ease-out group-data-[active=driver]:translate-x-[calc(100%+0.25rem)]"></span>
          <button type="button" data-pkg-btn="lepas_kunci" aria-pressed="true" class="relative min-h-11 rounded-full px-4 text-label-md text-muted aria-pressed:text-white">Lepas Kunci</button>
          <button type="button" data-pkg-btn="dengan_supir" aria-pressed="false" class="relative min-h-11 rounded-full px-4 text-label-md text-muted aria-pressed:text-white">Dengan Supir</button>
        </div>
      </div>

      {categories.length > 1 && (
        <div role="group" aria-label="Filter kategori" class="mt-4 -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:flex-wrap md:justify-center md:overflow-visible md:px-0 [scrollbar-width:none]">
          <button type="button" data-cat-btn="all" aria-pressed="true" class:list={[pill, 'shrink-0']}>Semua</button>
          {categories.map((c) => <button type="button" data-cat-btn={c} aria-pressed="false" class:list={[pill, 'shrink-0']}>{c}</button>)}
        </div>
      )}

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {cars.map((car, i) => <CarCard car={car} phone={phone} eager={i < 3} />)}
      </div>

      <div data-empty hidden={cars.length > 0} class="mt-8 rounded-card border border-line bg-card p-8 text-center">
        <p class="text-body-lg">{cars.length ? 'Tidak ada unit di kategori ini.' : 'Daftar armada sedang diperbarui.'}</p>
        <p class="mt-1 text-body-sm text-muted">Tidak menemukan yang dicari? Tanya admin, kami bantu carikan.</p>
        {emptyWaUrl && (
          <a href={emptyWaUrl} target="_blank" rel="noopener noreferrer" data-wa-track="true" data-wa-location="empty_state" class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-control bg-wa px-5 text-label-md text-white hover:bg-wa-hover">
            <WhatsAppIcon class="size-4" /> Tanya via WhatsApp
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  type Pkg = 'lepas_kunci' | 'dengan_supir';
  const root = document.querySelector<HTMLElement>('[data-catalog]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-car-card]')];
    const pkgButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-pkg-btn]')];
    const catButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-cat-btn]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const group = root.querySelector<HTMLElement>('[data-pkg-group]');
    let pkg: Pkg = 'lepas_kunci';
    let category = 'all';

    const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Text that actually changed fades in (single-package units keep their text, so they do not flicker)
    function setText(el: Element, text: string) {
      if (el.textContent === text) return;
      el.textContent = text;
      if (motion) el.animate([{ opacity: 0.2 }, { opacity: 1 }], { duration: 250, easing: 'ease-out' });
    }

    function render() {
      let visible = 0;
      for (const card of cards) {
        const d = card.dataset;
        // A single-package unit keeps its only package whatever the toggle says
        const want = pkg === 'lepas_kunci' ? 'lk' : 'ds';
        const key = d[`${want}Price`] ? want : want === 'lk' ? 'ds' : 'lk';
        const effective: Pkg = key === 'lk' ? 'lepas_kunci' : 'dengan_supir';
        setText(card.querySelector('[data-price]')!, d[`${key}Price`] ?? '');
        setText(card.querySelector('[data-note]')!, d[`${key}Note`] ?? '');
        setText(card.querySelector('[data-label]')!, effective === 'lepas_kunci' ? 'Lepas Kunci' : 'Dengan Supir');
        const cta = card.querySelector<HTMLAnchorElement>('[data-cta]');
        if (cta) {
          cta.href = d[`${key}Wa`] ?? '';
          cta.dataset.packageType = effective;
        }
        const show = category === 'all' || d.category === category;
        const wasHidden = card.hidden;
        card.hidden = !show;
        if (show) visible++;
        if (show && wasHidden) {
          card.removeAttribute('data-reveal'); // a filtered-in card animates here, not via scroll reveal
          if (motion) card.animate([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }], { duration: 350, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
        }
      }
      if (empty) empty.hidden = visible > 0;
    }

    pkgButtons.forEach((b) => b.addEventListener('click', () => {
      pkg = b.dataset.pkgBtn as Pkg;
      pkgButtons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      // underscores in a Tailwind data-variant value become spaces, hence "driver" instead of "dengan_supir"
      if (group) group.dataset.active = pkg === 'dengan_supir' ? 'driver' : 'self';
      render();
    }));
    catButtons.forEach((b) => b.addEventListener('click', () => {
      category = b.dataset.catBtn ?? 'all';
      catButtons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      render();
    }));
  }
</script>
